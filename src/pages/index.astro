---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';
import Logo from "src/components/Logo.astro";

---

<BaseLayout title={SITE.name}>
<div class="relative overflow-hidden">
<div class="pointer-events-none absolute top-5 left-0 opacity-5 overflow-hidden" aria-hidden="true">
  <Logo 
    width="2000" 
    height="2000" 
    fill="ink" 
    class="object-cover -translate-x-3/8"
  />
</div>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">

    <div class="flex items-center justify-center gap-3">
      <h1 class="font-display text-ink max-w-2xl text-3xl sm:text-4xl md:text-5xl leading-[1.1] font-medium sm:text-5xl">
      {SITE.tagline}
      </h1>
      <Logo class= "w-50 h-25 md:w-80 md:h-40"/>
    </div>
    <p class="text-ink-soft mt-6 max-w-md">
      Welcome to my personal little website! It is structured into two major components, my role as a scientist and my role as an arborist. In each you will find blog-posts, some information about ongoing and past projects and a gallery. This website is still in the making, which is why features will be added one by one. Currently, the scientist page is written only in english, while the arborist page is written in german
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/scientist" variant="solid">The scientist</Button>
      <Button href="/arborist" variant="solid">The arborist</Button>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
    <SectionHeading eyebrow="Let's talk" />
    <a
      href={`mailto:${SITE.email}`} 
      class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
    >
      {SITE.email}
    </a>
  </section>
</div>
</BaseLayout>
