---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';
import Logo from "src/components/Logo.astro";

---

<BaseLayout title={SITE.name}>
<div class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 flex items-start justify-start opacity-5"
    aria-hidden="true">
      <Logo width={1500} height={1500} fill="ink"  class="-translate-x-1/4"/>
  </div>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {SITE.status}
    </p>
    <div class="flex items-center justify-center gap-3">
      <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
      Using LiDAR for forest inventory and to quantify ecosystem features
      </h1>
      <Logo class= "w-80 h-40 md:w-80 md:h-40"/>
    </div>
    <p class="text-ink-soft mt-6 max-w-md">
      This is the page about my work as a forest scientist. If you are interested in my tree climbing work, click below.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/arborist" variant="solid">Tillman Reuter, arborist</Button>
      <Button href="#contact" variant="ghost">Contact me!</Button>
    </div>
  </section>

  <section id="cv" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="CV" />
    <p class="text-ink-soft max-w-xl">
      <b>2026:</b> Research scientist at Dep. Spatial Structures and Digitization of Forests (Uni Göttingen) <br/>
      <b>2025:</b> M.Sc Forest and Ecosystem Sciences <br/>
      <b>2023:</b> B.Eng Forest Engineering <br/>
    </p>
    <a href="/downloads/CV_scientist" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
      My full CV ->
    </a>
  </section>

  <section id="publications" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Publications" />
    <p class="text-ink-soft max-w-xl">
      <b>Reuter, T.</b>, Seidel, S., & Seidel, D. (2026). Comparing Two Novel LiDAR-Based Indices for Quantifying Forest Structural Complexity. Ecology and Evolution, 16(5), e73605.

    </p>
    <a href="https://doi.org/10.1002/ece3.73605" target="_blank" rel="noopener noreferrer" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
      doi.org/10.1002/ece3.73605 ->
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
    <SectionHeading eyebrow="Contact" />
    <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
      Interested in my work? 
    </p>
    <a
      href={`mailto:${SITE.email}`} 
      class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
    >
      {SITE.email}
    </a>
  </section>
</div>
</BaseLayout>
