---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex max-w-3xl flex-col items-start gap-4 px-6 py-32">
    <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">404</p>
    <h1 class="font-display text-ink text-3xl font-medium">This page doesn't exist.</h1>
    <p class="text-ink-soft">The requested page does not exist. Seems like I made a mistake or didn't have the time to create this page yet. Forgive me please.</p>
    <a href="/" class="text-signal font-mono text-sm hover:underline">← Back to a site I promise you does exist</a>
  </section>
</BaseLayout>
