---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';
import Logo from "src/components/Logo.astro";

---

<BaseLayout title={SITE.name}>

  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 flex items-start justify-center opacity-5"
    aria-hidden="true">
      <Logo width={2000} height={2000} fill="ink"  class="-translate-x-1/4"/>
    </div>
    <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
      <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
        <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        Nehme ab Oktober in und 100km um Göttingen gerne wieder Aufträge an
      </p>
      <div class="flex items-center justify-center gap-3">
        <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
          Baumkletterer seit 2005, mit Gurt, Helm und Seil seit 2019
        </h1>
        <Logo class= "w-80 h-40 md:w-80 md:h-40"/>
      </div>
      <p class="text-ink-soft mt-6 max-w-md">
        Du bist auf der Seite, die sich mit meinem Dasein als Baumkletterer beschäftigt. Wenn du dich für meine Arbeit als Forstwissenschaftler interessierst, klick hier.
      </p>
      
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/scientist" variant="solid">Tillman Reuter, Forstwissenschaftler</Button>
        <Button href="#contact" variant="ghost">Schreib mir!</Button>
      </div>
    </section>
    
    <section id="offer" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="Was ich anbiete" />
      <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
        Mit der Handsäge im Baum
      </p>
      <p class="text-ink-soft max-w-xl whitespace-pre-line">
        - Totholzentfernung <br/>
        - Pflegeschnitte <br/>
        - Leichte Einkürzungen <br/>
        - Kleine Fällungen <br/>
      </p>
    </section>

    <section id="about" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="Werdegang" />
      <p class="text-ink-soft max-w-xl whitespace-pre-line">
        <b>2025:</b> Gründung des Einzelunternehmen "Tillman Reuter Seilklettertechnik" <br/>
        <b>2023:</b> Abschluss Forstingenieur (B.Eng.) <br/>
        <b>2021-22:</b> Angestellter Baumpfleger (Minijob) <br/>
        <b>2020:</b> AS-Baum 1 Motorsägenlehrgang <br/>
        <b>2019:</b> SKT-A Zertifizierung <br/>
        <b>2019:</b> Erstes Praktikum in der Baumpflege <br/>
      </p>
      <a href="/documents/cv" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
        Mein Lebenslauf →
      </a>
    </section>
    
    <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
      <SectionHeading eyebrow="Kontakt" />
      <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
        Du suchst einen Baumkletterer?
      </p>
      <a
      href={`mailto:${SITE.email}`} 
      class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
      >
      {SITE.email}
    </a>
  </section>
</div>
  
</BaseLayout>
