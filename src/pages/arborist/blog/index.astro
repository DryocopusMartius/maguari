---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const allWork = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((entry) => entry.data.tags?.includes('arborist'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Alle Blog Posts"
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Blog posts" count={allWork.length} />
    <div>
      {allWork.map((entry) => 
        <a href={`/arborist/blog/${entry.id} of my blog posts`} class="block border-b border-line py-4">
          <h2 class="font-display text-ink text-xl">{entry.data.title}</h2>
          <p class="text-ink-soft text-sm">{entry.data.summary}</p>
        </a>)}
    </div>
  </section>
</BaseLayout>
