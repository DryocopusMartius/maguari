---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import Logo from "@/components/Logo.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image = '/og-image.png' } = Astro.props;

const pathname = Astro.url.pathname;
let section: 'arborist' | 'scientist' | 'default' = 'default';
if (pathname.startsWith('/scientist')) section = 'scientist';
else if (pathname.startsWith('/arborist')) section = 'arborist';
---

<!doctype html>
<html lang={SITE.locale} data-section={section}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body id="top" class="bg-paper text-ink">
    <Header section={section} />
    <main>
    <div class="relative overflow-hidden">
      <div class="pointer-events-none absolute top-5 left-0 opacity-5 overflow-hidden" aria-hidden="true">
        <Logo 
          width="2000" 
          height="2000" 
          fill="ink" 
          class="object-cover -translate-x-3/8"
        />
      </div>
      <slot />
    </div>
    </main>
    <div id="bottom"></div>
    <Footer />
  </body>
</html>
