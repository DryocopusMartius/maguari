---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image = '/og-image.png' } = Astro.props;

// doesn't work yet, pathname is not created
const pathname = Astro.url.pathname;
let section = 'default'; // fallback
if (pathname.startsWith('/scientist')) section = 'scientist';
else if (pathname.startsWith('/arborist')) section = 'arborist';
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead title={title} description={description} image={image} data-section={section}/>
  </head>
  <body id="top" class="bg-paper text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
