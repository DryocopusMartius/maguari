---
import { SITE } from '@/site.config';

const year = new Date().getFullYear();
---

<footer class="border-line border-t">
  <div
    class="text-ink-soft mx-auto flex max-w-3xl flex-col px-6 py-5 font-mono text-[8px] sm:text-[11px] sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.name} - built using a template by BracoZS</p>

    <nav class="flex items-center gap-4" aria-label="Social">
      {
        SITE.social.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="hover:text-signal transition-colors" rel="me">
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="hover:text-signal transition-colors"> Top ↑ </a>
    </nav>
  </div>
</footer>
