---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';
import Logo from "@/components/Logo.astro";

// 1. Declare the prop
export interface Props {
  section?: 'arborist' | 'scientist' | 'default';
}

// 2. Destructure it (with a fallback)
const { section = 'default' } = Astro.props;

// 3. Now this line works
const navLinks = NAV_LINKS[section] || NAV_LINKS.default;

const currentPath = Astro.url.pathname;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-ink text-sm sm:text-2xl font-medium flex items-center gap-2">
<Logo class="w-8 h-8"/>
  {SITE.name}
</a>

    <nav class="flex items-center gap-2 sm:gap-7" aria-label="Primary">
      {
        navLinks.map((link) => {
          const isActive = currentPath.replace(/\/$/, '') === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-[9px] sm:text-sm tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }

      <ThemeToggle />
    </nav>
  </div>
</header>
