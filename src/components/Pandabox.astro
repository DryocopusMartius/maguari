---
// src/components/Pandabox.astro
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

export interface Props {
  galleryid: string;
  transitionType?: "fade" | "slide";
}

const { galleryid, transitionType = "fade" } = Astro.props;

// Fetch the specific gallery data based on the ID passed in
const galleryEntry = await getEntry("galleries", galleryid);

if (!galleryEntry) {
  throw new Error(`Gallery with id "${galleryid}" not found in content/galleries`);
}

const images = galleryEntry.data.images;
---

<!-- Gallery Grid -->
<div class="gallery-grid" id="gallery-{galleryid}">
  {
    images.map((image, index) => (
      <div class="gallery-item" data-index={index}>
        <Image
          src={image.src}
          alt={image.alt}
          widths={[500, 1000, 1500]}
          sizes="(min-width: 900px) 400px, (min-width: 600px) 50vw, 100vw"
          loading="lazy"
          class="gallery-img"
        />
        <div class="overlay">
          <h3>{image.title}</h3>
          <p>{image.description}</p>
        </div>
      </div>
    ))
  }
</div>

<!-- Lightbox Modal -->
<div id="lightbox" class="lightbox hidden">
  <button id="close-lightbox" class="close-btn">&times;</button>
  <img id="lightbox-img" src="" alt="Enlarged view" />
  <div id="lightbox-caption"></div>
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1rem;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    cursor: pointer;
    aspect-ratio: 4 / 3;
    background: #f0f0f0;
    transition: transform 0.25s ease;
  }

  .gallery-item:hover {
    transform: scale(1.02);
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 1rem 1rem 1rem;
    background: linear-gradient(0deg, rgba(0,0,0,0.7) 0%, transparent 100%);
    color: white;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .overlay h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .overlay p {
    margin: 0.25rem 0 0 0;
    font-size: 0.85rem;
    opacity: 0.85;
  }

  /* Lightbox styles */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.3s ease;
  }

  .lightbox.hidden {
    display: none;
    opacity: 0;
  }

  .lightbox:not(.hidden) {
    display: flex;
    opacity: 1;
  }

  #lightbox-img {
    max-width: 90%;
    max-height: 80%;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.8);
  }

  #lightbox-caption {
    color: white;
    margin-top: 1.5rem;
    font-size: 1.1rem;
    text-align: center;
    max-width: 80%;
  }

  .close-btn {
    position: absolute;
    top: 2rem;
    right: 2.5rem;
    color: white;
    font-size: 3rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0 0.75rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .close-btn:hover {
    transform: scale(1.2);
  }
</style>

<script lang="ts">
  // This runs on the client to handle the lightbox interactions
  document.addEventListener("DOMContentLoaded", function () {
    const items = document.querySelectorAll(".gallery-item");
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const caption = document.getElementById("lightbox-caption");
    const closeBtn = document.getElementById("close-lightbox");

    // Helper to get the actual image source from the optimized <img> tag
    function getImageSrc(item) {
      const img = item.querySelector(".gallery-img");
      return img ? img.src : "";
    }

    function getImageAlt(item) {
      const img = item.querySelector(".gallery-img");
      return img ? img.alt : "";
    }

    function getTitle(item) {
      const h3 = item.querySelector(".overlay h3");
      return h3 ? h3.textContent : "";
    }

    function getDescription(item) {
      const p = item.querySelector(".overlay p");
      return p ? p.textContent : "";
    }

    // Open lightbox on click
    items.forEach((item) => {
      item.addEventListener("click", function () {
        const src = getImageSrc(this);
        const alt = getImageAlt(this);
        const title = getTitle(this);
        const desc = getDescription(this);

        if (src) {
          lightboxImg.src = src;
          lightboxImg.alt = alt;
          caption.innerHTML = `<strong>${title}</strong> — ${desc}`;
          lightbox.classList.remove("hidden");
        }
      });
    });

    // Close lightbox
    function closeLightbox() {
      lightbox.classList.add("hidden");
    }

    closeBtn.addEventListener("click", closeLightbox);

    // Close on clicking the background (the lightbox itself, not the image)
    lightbox.addEventListener("click", function (e) {
      if (e.target === this) {
        closeLightbox();
      }
    });

    // Close with ESC key
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });
  });
</script>